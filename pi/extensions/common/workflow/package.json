  "license": "MIT",
  "dependencies": {
    "acorn": "^8.16.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@earendil-works/pi-ai": "0.78.0",
    "@earendil-works/pi-coding-agent": "0.78.0",
    "@earendil-works/pi-tui": "0.78.0",
    "tsx": "latest",
    "typebox": "latest",
    "typescript": "latest"
  },
  "private": true
