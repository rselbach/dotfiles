# Bootstrap the ordered Bash config fragments.
_bashrc_source="${BASH_SOURCE[0]}"

while [[ -L "${_bashrc_source}" ]]; do
  _bashrc_dir="${_bashrc_source%/*}"
  [[ "${_bashrc_dir}" != "${_bashrc_source}" ]] || _bashrc_dir='.'

  if ! _bashrc_target="$(readlink "${_bashrc_source}")"; then
    printf 'failed to resolve %s\n' "${_bashrc_source}" >&2
    return 1
  fi

  case "${_bashrc_target}" in
    /*) _bashrc_source="${_bashrc_target}" ;;
    *) _bashrc_source="${_bashrc_dir}/${_bashrc_target}" ;;
  esac
done

_bashrc_dir="${_bashrc_source%/*}"
[[ "${_bashrc_dir}" != "${_bashrc_source}" ]] || _bashrc_dir='.'

# shellcheck disable=SC1091
if ! source "${_bashrc_dir}/rc"; then
  printf 'failed to load Bash configuration\n' >&2
  unset _bashrc_dir _bashrc_source _bashrc_target
  return 1
fi

# Machine-specific overrides stay last.
if [[ -f "${HOME}/.bash.local" ]]; then
  # shellcheck source=/dev/null
  if ! source "${HOME}/.bash.local"; then
    printf 'failed to load ~/.bash.local\n' >&2
    unset _bashrc_dir _bashrc_source _bashrc_target
    return 1
  fi
fi

unset _bashrc_dir _bashrc_source _bashrc_target
