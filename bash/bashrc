# Reproduce the Starship prompt with Bash built-ins and jj-git-prompt.

prompt::directory() {
  local root="${PWD}"
  local parent
  local display
  local leading=""
  local -a parts
  local index

  while [[ ! -d "${root}/.jj" && ! -e "${root}/.git" ]]; do
    parent="${root%/*}"
    [[ -n "${parent}" ]] || parent="/"
    if [[ "${parent}" == "${root}" ]]; then
      root=""
      break
    fi
    root="${parent}"
  done

  if [[ -n "${root}" ]]; then
    if [[ "${root}" == "/" ]]; then
      display="${PWD}"
    elif [[ "${PWD}" == "${root}" ]]; then
      display="${root##*/}"
    else
      display="${root##*/}/${PWD#"${root}/"}"
    fi
  else
    case "${PWD}" in
      "${HOME}") display='~' ;;
      "${HOME}/"*)
        display='~'
        display+="/${PWD#"${HOME}/"}"
        ;;
      *) display="${PWD}" ;;
    esac
  fi

  if [[ "${display}" == /* ]]; then
    leading="/"
    display="${display#/}"
  fi

  IFS="/" read -r -a parts <<< "${display}"
  if (( ${#parts[@]} > 4 )); then
    index=$((${#parts[@]} - 4))
    display="${parts[${index}]}"
    for ((index += 1; index < ${#parts[@]}; index += 1)); do
      display+="/${parts[${index}]}"
    done
  else
    display="${leading}${display}"
  fi

  # Prevent path backslashes from being interpreted as Bash prompt escapes.
  PROMPT_DIRECTORY="${display//\\/\\\\}"
}

prompt::update() {
  local exit_status=$?
  local reset='\[\033[0m\]'
  local bold_green='\[\033[1;32m\]'
  local green='\[\033[32m\]'
  local red='\[\033[31m\]'
  local blue='\[\033[34m\]'
  local hostname=""
  local vcs=""
  local vcs_segment=""
  local directory
  local arrow

  prompt::directory

  if [[ -n "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" ]]; then
    hostname="${bold_green}${HOSTNAME%%.*}${reset} "
  fi

  if ! vcs="$("${HOME}/.local/bin/jj-git-prompt" prompt -bash)"; then
    vcs=""
  fi
  [[ -z "${vcs}" ]] || vcs_segment="${vcs} "

  directory="${blue}${PROMPT_DIRECTORY}${reset}"
  if [[ ! -w "${PWD}" ]]; then
    directory+="${red}🔒${reset}"
  fi

  if (( exit_status == 0 )); then
    arrow="${green}➜${reset}"
  else
    arrow="${red}➜${reset}"
  fi

  printf -v PS1 '%s%s%s %s ' \
    "${hostname}" "${vcs_segment}" "${directory}" "${arrow}"
}

[[ $- == *i* ]] || return 0

# PS1 is fully rendered by PROMPT_COMMAND; disable its second expansion pass.
shopt -u promptvars

case ";${PROMPT_COMMAND:-};" in
  *';prompt::update;'*) ;;
  *) PROMPT_COMMAND="prompt::update${PROMPT_COMMAND:+;${PROMPT_COMMAND}}" ;;
esac
