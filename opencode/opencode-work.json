{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama-local": {
      "npm": "@ai-sdk/openai",
      "name": "Ollama on rhea",
      "options": {
        "baseURL": "http://rhea.local:11434/v1",
        "apiKey": "not-used",
        "verbosity": "low"
      },
      "models": {
        "granite-4.1-8b": {
          "name": "granite-4.1-8b",
          "reasoning": false,
          "tool_call": true,
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "qwen3.5:9b-mlx": {
          "name": "qwen3.5:9b-mlx",
          "reasoning": true,
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "reasoningEffort": "max"
            }
          },
          "tool_call": true,
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "mcp": {
    "excalidraw": {
      "type": "remote",
      "url": "https://api.excalidraw.com/api/v1/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:EXCALIDRAW_API_KEY}"
      }
    }
  },
  "plugin": [
    "./plugins/opencode-codex-identity-plugin.ts",
    "@hashicorp/opencode-bob-gateway-plugin",
  ],
  "permission": {
    "*": "allow"
  }
}
