{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "ollama-local": {
      "package": "aisdk:@ai-sdk/openai",
      "name": "Ollama on rhea",
      "settings": {
        "baseURL": "http://rhea.local:11434/v1",
        "apiKey": "not-used",
        "verbosity": "low"
      },
      "models": {
        "granite-4.1-8b": {
          "name": "granite-4.1-8b",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1050000,
            "output": 128000
          }
        },
        "qwen3.8:27b": {
          "name": "qwen3.8:27b",
          "variants": [
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low"
              }
            },
            {
              "id": "medium",
              "settings": {
                "reasoningEffort": "medium"
              }
            },
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high"
              }
            },
            {
              "id": "xhigh",
              "settings": {
                "reasoningEffort": "xhigh"
              }
            },
            {
              "id": "max",
              "settings": {
                "reasoningEffort": "max"
              }
            }
          ],
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1050000,
            "output": 128000
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "excalidraw": {
        "type": "remote",
        "url": "https://api.excalidraw.com/api/v1/mcp",
        "disabled": false,
        "headers": {
          "Authorization": "Bearer {env:EXCALIDRAW_API_KEY}"
        }
      },
      "atlassian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v1/mcp/authv2",
        "disabled": false
      }
    }
  },
  "plugins": [
    "./plugins/opencode-codex-identity-plugin.ts",
  ],
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ]
}
