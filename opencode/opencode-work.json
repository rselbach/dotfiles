{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ibm-bob": {
      "options": {
        "instanceID": "37f54b01-2dec-4737-bf93-c094a5f95e7c",
        "teamID": "019ddffb-8c71-79f6-bd0a-feb1a597b638"
      }
    },
    "ollama-local": {
      "npm": "@ai-sdk/openai",
      "name": "Ollama on rhea",
      "options": {
        "baseURL": "http://rhea.local:8787/v1",
        "apiKey": "not-used",
        "verbosity": "low"
      },
      "models": {
        "local": {
          "name": "Ollama local",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "mcp": {
    "excalidraw": {
      "type": "remote",
      "url": "https://api.excalidraw.com/api/v1/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:EXCALIDRAW_API_KEY}"
      }
    }
  },
  "plugin": [
    "./plugins/opencode-codex-identity-plugin.ts",
    "@hashicorp/opencode-bob-gateway-plugin",
  ],
  "permission": {
    "*": "allow"
  }
}
