{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama-local": {
      "npm": "@ai-sdk/openai",
      "name": "Ollama on rhea",
      "options": {
        "baseURL": "http://rhea.local:11434/v1",
        "apiKey": "not-used",
        "verbosity": "low"
      },
      "models": {
        "local": {
          "name": "Ollama local",
          "tool_call": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1050000,
            "output": 128000
          }
        }
      }
    }
  },
  "mcp": {
    "excalidraw": {
      "type": "remote",
      "url": "https://api.excalidraw.com/api/v1/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:EXCALIDRAW_API_KEY}"
      }
    },
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      "enabled": true
    }
  },
  "plugin": [
    "./plugins/opencode-codex-identity-plugin.ts"
  ],
  "permission": "allow"
}
