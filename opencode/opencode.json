{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "ollama-local": {
      "package": "aisdk:@ai-sdk/openai",
      "name": "Ollama on rhea",
      "settings": {
        "baseURL": "http://rhea.local:8787/v1",
        "apiKey": "not-used",
        "verbosity": "low"
      },
      "models": {
        "local": {
          "name": "Ollama local",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1050000,
            "output": 128000
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "excalidraw": {
        "type": "remote",
        "url": "https://api.excalidraw.com/api/v1/mcp",
        "disabled": false,
        "headers": {
          "Authorization": "Bearer {env:EXCALIDRAW_API_KEY}"
        }
      },
      "cloudflare": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp"
      },
      "atlassian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v1/mcp/authv2",
        "disabled": false
      }
    }
  },
  "plugins": [
    "./plugins/opencode-codex-identity-plugin.ts"
  ],
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ]
}
