{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "moonshotai": {
      "options": {
        "baseURL": "https://api.kimi.com/coding/v1"
      }
    },
    "openai": {
      "options": {
        "text": {
          "verbosity": "low"
        }
      }
    }
  },
  "mcp": {
    "excalidraw": {
      "type": "remote",
      "url": "https://api.excalidraw.com/api/v1/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:EXCALIDRAW_API_KEY}"
      }
    }
  },
  "plugin": [
    "./plugins/opencode-codex-identity-plugin.ts"
  ],
  "permission": {
    "*": "allow"
  }
}
