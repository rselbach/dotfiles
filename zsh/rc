# Load the ordered Zsh configuration fragments.
_rc_dir="${${(%):-%N}:A:h}"

# Iterate without redirecting stdin so fragments see the real terminal.
for _rc_file in "${_rc_dir}"/rc.d/*.zsh(N); do
  if ! source "${_rc_file}"; then
    printf 'failed to load %s\n' "${_rc_file}" >&2
    unset _rc_dir _rc_file
    return 1
  fi
done

unset _rc_dir _rc_file
