# Load shared and Zsh configuration fragments by stem.
_rc_dir="${${(%):-%N}:A:h}"
_shells_rc_dir="${_rc_dir:h}/shells/rc.d"
_rc_shell='zsh'

if ! _rc_names="$(
  set -o pipefail
  for _rc_file in \
    "${_shells_rc_dir}"/*.sh(N) \
    "${_rc_dir}"/rc.d/*.zsh(N); do
    _rc_name="${_rc_file:t}"
    printf '%s\n' "${_rc_name:r}"
  done | LC_ALL=C sort -u
)"; then
  printf '%s\n' 'failed to enumerate Zsh configuration fragments' >&2
  unset _rc_dir _shells_rc_dir _rc_shell _rc_file _rc_name _rc_names
  return 1
fi

# Iterate without redirecting stdin so fragments see the real terminal.
for _rc_name in ${(f)_rc_names}; do
  for _rc_file in \
    "${_shells_rc_dir}/${_rc_name}.sh" \
    "${_rc_dir}/rc.d/${_rc_name}.zsh"; do
    [[ -e "${_rc_file}" ]] || continue
    if ! source "${_rc_file}"; then
      printf 'failed to load %s\n' "${_rc_file}" >&2
      unset _rc_dir _shells_rc_dir _rc_shell _rc_file _rc_name _rc_names
      return 1
    fi
  done
done

unset _rc_dir _shells_rc_dir _rc_shell _rc_file _rc_name _rc_names
