# Bootstrap the ordered Zsh config fragments.
_zshrc_dir="${${(%):-%N}:A:h}"

if ! source "${_zshrc_dir}/rc"; then
  printf '%s\n' 'failed to load Zsh configuration' >&2
  unset _zshrc_dir
  return 1
fi

# Machine-specific overrides stay last.
if [[ -f "${HOME}/.zsh.local" ]]; then
  if ! source "${HOME}/.zsh.local"; then
    printf '%s\n' 'failed to load ~/.zsh.local' >&2
    unset _zshrc_dir
    return 1
  fi
fi

unset _zshrc_dir

export PATH="/Users/rselbach/.local/bin:$PATH"

# bun completions
[ -s "/Users/rselbach/.bun/_bun" ] && source "/Users/rselbach/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
